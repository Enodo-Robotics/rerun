FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# System dependencies for building Rerun (native viewer + wheel)
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    curl \
    git \
    libatk-bridge2.0-dev \
    libatk1.0-dev \
    libfontconfig-dev \
    libfreetype-dev \
    libgl-dev \
    libglib2.0-dev \
    libgtk-3-dev \
    libpango1.0-dev \
    libssl-dev \
    libvulkan-dev \
    libxcb-render0-dev \
    libxcb-shape0-dev \
    libxcb-xfixes0-dev \
    libxkbcommon-dev \
    nasm \
    pkg-config \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Rust toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.84.0
ENV PATH="/root/.cargo/bin:${PATH}"

# Python build tools
RUN pip3 install maturin

WORKDIR /build
